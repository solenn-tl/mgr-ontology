@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ebucore: <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#> .
@prefix mgr: <http://data.mgr.fr/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix time: <http://www.w3.org/2006/time#> .

### ==========================================
### Classes 
### ==========================================

mgr:Recording a rdfs:Class ;
    rdfs:label "Recording"@en, "Enregistrement"@fr ;
    rdfs:comment "A video or audio realization that fixes a record of a talk or event."@en ;
    rdfs:subClassOf schema:MediaObject .

mgr:RecordingPart a rdfs:Class ;
    rdfs:label "Recording Part"@en, "Partie d'enregistrement"@fr ;
    rdfs:comment "A segment or excerpt of a top-level recording."@en ;
    rdfs:subClassOf schema:MediaObject .

### ==========================================
### Object Properties
### ==========================================

mgr:isRecordingOf a owl:ObjectProperty ;
    rdfs:label "is recording of"@en, "est l'enregistrement de"@fr ;
    rdfs:comment "Relates a recording to the talk it captures."@en ;
    rdfs:domain mgr:Recording ;
    rdfs:range mgr:Talk ;
    rdfs:subPropertyOf schema:about .

mgr:hasRecordingPart a owl:ObjectProperty ;
    rdfs:label "has recording part"@en, "a pour partie d'enregistrement"@fr ;
    rdfs:comment "Relates a top-level recording to one of its segments or parts."@en ;
    rdfs:domain mgr:Recording ;
    rdfs:range mgr:RecordingPart ;
    rdfs:subPropertyOf schema:hasPart, dcterms:hasPart .

mgr:isPartOfRecording a owl:ObjectProperty ;
    rdfs:label "is part of recording"@en, "fait partie de l'enregistrement"@fr ;
    rdfs:comment "Relates a recording part to its parent top-level recording."@en ;
    rdfs:domain mgr:RecordingPart ;
    rdfs:range mgr:Recording ;
    rdfs:subPropertyOf schema:isPartOf, dcterms:isPartOf .

mgr:depictsTalkPart a owl:ObjectProperty ;
    rdfs:label "depicts talk part"@en, "illustre la partie de conférence"@fr ;
    rdfs:comment "Connects a recording part to the intellectual discourse segment (TalkPart) it captures."@en ;
    rdfs:domain mgr:RecordingPart ;
    rdfs:range mgr:TalkPart .

mgr:hasDirector a owl:ObjectProperty ;
    rdfs:label "has director"@en, "a pour réalisateur"@fr ;
    rdfs:comment "Relates a recording to the person in charge of recording and/or editing."@en ;
    rdfs:domain mgr:Recording ;
    rdfs:range schema:Person ;
    rdfs:subPropertyOf schema:director.

mgr:isDirectorOf a owl:ObjectProperty ;
    rdfs:label "is director of"@en, "est le réalisateur de"@fr ;
    rdfs:comment "Relates a person to the recording they directed."@en ;
    rdfs:domain schema:Person ;
    rdfs:range mgr:Recording ;
    rdfs:subPropertyOf schema:director.

### ==========================================
### Datatype Properties
### ==========================================

mgr:noticeType a owl:DatatypeProperty ;
    rdfs:label "notice type"@en, "type de notice"@fr ;
    rdfs:comment "Philharmonie-specific metadata property about the file notice type (e.g., MPA1, MPA2)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

mgr:recordingType a owl:DatatypeProperty ;
    rdfs:label "recording type"@en, "type d'enregistrement"@fr ;
    rdfs:comment "The general media type, such as audio or video."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (mgr:Recording mgr:RecordingPart) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:encodingFormat .

mgr:mediaFormat a owl:DatatypeProperty ;
    rdfs:label "media format"@en, "format du média"@fr ;
    rdfs:comment "The specific technical format of the video or audio track (e.g., mp3, mp4, wav)."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (mgr:Recording mgr:RecordingPart) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:format, schema:fileFormat .

mgr:startTime a owl:DatatypeProperty ;
    rdfs:label "start time"@en, "temps de début"@fr ;
    rdfs:comment "Start timestamp in seconds relative to the full recording file."@en ;
    rdfs:domain mgr:RecordingPart ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:startTime .

mgr:endTime a owl:DatatypeProperty ;
    rdfs:label "end time"@en, "temps de fin"@fr ;
    rdfs:comment "End timestamp in seconds relative to the full recording file."@en ;
    rdfs:domain mgr:RecordingPart ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:endTime .